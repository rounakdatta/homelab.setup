# Kubeconfig files
.k3s-kubeconfig.yaml
*.kubeconfig

# Ansible retry files
*.retry

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment files
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Secrets and sensitive data
secrets/
secrets.yaml
*.pem
*.key
*.crt
!ansible/roles/*/files/*.crt  # Allow role-specific certs if needed

# Backup files
*.backup
*.bak

# Logs
*.log

# Helm charts are vendored, not ignored. `kustomize build --enable-helm`
# inflates them into kubernetes/**/charts/ and they are committed, so a deploy
# renders from the tree instead of fetching 17 charts from upstream on every
# run. Re-render and commit the result whenever a chart `version:` changes.

# agent-smith drops per-machine skill symlinks here (absolute paths into
# ~/.cache), which are dangling for anyone else who clones this repo.
.claude/skills/
