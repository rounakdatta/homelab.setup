# Managed by homelab.setup (ansible/roles/disk-hygiene).
# 03:10 IST: after the evening's deploys, before Velero's 22:30 UTC backup.
[Unit]
Description=Daily: remove container images that nothing on this node uses

[Timer]
OnCalendar=*-*-* 21:40:00 UTC
RandomizedDelaySec=10min
# No catch-up after a missed day (Persistent): at boot the pods are still
# being recreated, and tomorrow's run does the same work.

[Install]
WantedBy=timers.target
