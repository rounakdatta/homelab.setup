# Bitwarden API Credentials
# Get these from Bitwarden web vault: Settings → Security → Keys → View API Key
BW_CLIENTID="user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
BW_CLIENTSECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BW_PASSWORD="your-bitwarden-master-password"

# Tailscale machine hostnames (used for Ansible inventory)
CONTROL_MACHINE_NAME="your-tailscale-hostname-for-control-plane"
WORKER_MACHINE_NAME="your-tailscale-hostname-for-worker"

# K3s node token (from control plane: /var/lib/rancher/k3s/server/node-token)
K3S_NODE_TOKEN="your-k3s-node-token"

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual Bitwarden credentials
# 3. Fill in your Tailscale machine hostnames
# 4. Run: make secrets (or make infra for full setup)
#
# Note: .env is already in .gitignore and will NOT be committed
