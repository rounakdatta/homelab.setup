# Vendored Helm charts. These are upstream build artifacts, pulled by
# `kustomize build --enable-helm` and committed so a deploy reads the tree
# instead of 13 third-party hosts -- when the bjw-s chart repo started 404ing,
# one unfetchable chart broke every deploy.
#
# They are not hand-written and are never edited in place. Marking them
# vendored makes that visible where it matters: GitHub collapses them in
# diffs and leaves them out of the repo's language stats, so a chart bump
# stops looking like a thousand lines of authored YAML.
#
# kubernetes/charts.lock records where each one came from and pins its
# contents; .github/workflows/charts-lock.yml checks the tree against it.
kubernetes/**/charts/** linguist-vendored

# Generated by .github/scripts/charts-lock.py -- review the summary, not the hashes.
kubernetes/charts.lock linguist-generated
