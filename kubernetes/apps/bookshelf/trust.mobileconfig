	<key>PayloadDescription</key>
	<string>iOS 9 trusts the certificate authorities of 2015. This adds three that every current device already trusts (Let's Encrypt's ISRG Root X1 and X2, and Sectigo's USERTrust RSA), so Safari can open books.taptappers.club and most of today's web. Remove it any time in Settings &gt; General &gt; Profiles.</string>
	<key>PayloadDisplayName</key>
	<string>Certificate roots for the bookshelf</string>
	<key>PayloadIdentifier</key>
	<string>club.taptappers.books.trust</string>
